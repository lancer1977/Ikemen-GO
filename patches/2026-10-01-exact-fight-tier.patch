+
+func fightAuthorityTier(defKey string) string {
+	path := filepath.Join(sys.baseDir, "save", "fight_tiers.json")
+	if p := sys.cmdFlags["-stats"]; p != "" {
+		path = filepath.Join(filepath.Dir(p), "fight_tiers.json")
+	}
+	info, err := os.Stat(path)
+	if err != nil || time.Since(info.ModTime()) > 20*time.Minute {
+		return "" // missing or stale (audit service down): use stats.json
+	}
+	if mt := info.ModTime().UnixNano(); mt != fightAuthority.modTime {
+		var parsed struct {
+			Tiers map[string]string `json:"tiers"`
+		}
+		raw, err := os.ReadFile(path)
+		if err != nil || json.Unmarshal(raw, &parsed) != nil {
+			return ""
+		}
+		fightAuthority.modTime, fightAuthority.tiers = mt, parsed.Tiers
+	}
+	return fightAuthority.tiers[defKey]
+}
