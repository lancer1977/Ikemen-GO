+// Betting countdown: 30 s counting down, then a 5 s hold (owner, 2026-09-29):
+// the display stays at 0, the fighters are unfrozen once and play their
+// time-over lose pose (common state 170), then the one-shot reset starts the fight.
+const saltyBetCountdownSecs = 30
+const saltyBetHoldSecs = 5
+
+var saltyBetHoldKey string // match whose hold has already put the fighters in state 170
+
+// saltyBetCountdownElapsed: ticks since the countdown started, or -1 when no
+// countdown is running for the current match.
+func saltyBetCountdownElapsed() int32 {
 	matchKey := saltyBetCurrentMatchKey()
 	if matchKey != "" && matchKey != saltyBetCountdownMatchKey {
 		saltyBetCountdownStart = -1
@@ -2211,16 +2221,16 @@ func saltyBetCountdownRemaining() (int32, bool) {
 		saltyBetCountdownDoneKey = ""
 	}
 	if matchKey != "" && matchKey == saltyBetCountdownDoneKey {
-		return 0, false
+		return -1
 	}
 	if sys.roundState() < 1 || sys.roundState() > 2 {
-		return 0, false
+		return -1
 	}
 	if saltyBetCountdownStart < 0 {
 		saltyBetCountdownStart = int32(sys.tickCount)
 	}
-	remaining := int32(30) - (int32(sys.tickCount)-saltyBetCountdownStart)/60
-	if remaining <= 0 {
+	elapsed := int32(sys.tickCount) - saltyBetCountdownStart
+	if elapsed >= (saltyBetCountdownSecs+saltyBetHoldSecs)*60 {
 		if matchKey != "" {
