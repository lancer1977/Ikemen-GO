 		}
@@ -2228,11 +2238,49 @@ func saltyBetCountdownRemaining() (int32, bool) {
 			sys.roundResetFlg = true
 			sys.roundResetMatchStart = true
 		}
+		return -1
+	}
+	return elapsed
+}
+
+func saltyBetCountdownRemaining() (int32, bool) {
+	elapsed := saltyBetCountdownElapsed()
+	if elapsed < 0 {
 		return 0, false
 	}
+	remaining := int32(saltyBetCountdownSecs) - elapsed/60
+	if remaining < 0 {
+		remaining = 0 // hold: stays at 0
+	}
 	return remaining, true
 }
 
+// saltyBetHolding: the 5 s after the count hit 0.
+func saltyBetHolding() bool {
+	elapsed := saltyBetCountdownElapsed()
+	return elapsed >= saltyBetCountdownSecs*60
+}
+
+// saltyBetStartHold puts every fighter into its time-over lose pose once.
+func saltyBetStartHold() {
+	key := saltyBetCountdownMatchKey
+	if key == saltyBetHoldKey {
+		return
+	}
+	saltyBetHoldKey = key
+	for _, p := range sys.chars {
+		if len(p) == 0 || p[0] == nil {
+			continue
+		}
+		c := p[0]
+		anim := int32(-1)
+		if !c.selfAnimExist(BytecodeInt(170)).ToB() {
+			anim = 0 // no lose pose: stand instead of vanishing
+		}
+		c.selfState(170, anim, -1, 0, "")
+	}
+}
+
 func saltyBetCountdownActive() bool {
 	_, ok := saltyBetCountdownRemaining()
 	return ok
